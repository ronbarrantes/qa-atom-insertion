{
  "manifest_version": 3,
  "name": "QA Atom GTIN Link Inserter",
  "description": "Appends an Atom item-management link icon next to GTIN values on webpages.",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://atom.walmart.com/*",
        "https://teams.wal-mart.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
